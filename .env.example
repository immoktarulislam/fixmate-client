# FixMate client environment template.
# Copy to `.env.local` and fill in. Never commit the real file.

# BetterAuth — SECRET must equal JWT_SECRET on the Express server.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# MongoDB Atlas connection string (database: fixmate)
BETTER_AUTH_URI=
BETTER_AUTH_DB=fixmate

# Express API + public app URL
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional service-image uploads (ImgBB). Empty = local base64 fallback.
NEXT_PUBLIC_IMGBB_API_KEY=

# Optional social sign-in (buttons render only when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
